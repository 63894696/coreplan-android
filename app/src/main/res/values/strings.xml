    <!-- About screen -->
    <string name="about_app_name">Fitness Guide</string>
    <string name="about_intro_title">About</string>
    <string name="about_intro_text">This app catalogs 1,324 fitness exercises covering strength, cardio, and stretching. GIFs and base data come from an open dataset. We hope this helps you build your own training plans.</string>
    <string name="about_open_source_title">Open Source &amp; Free</string>
    <string name="about_open_source_text">Fully open source and free. No ads, no data collection, no login required. Code is on GitHub.</string>
    <string name="about_dataset_title">Dataset</string>
    <string name="about_dataset_text">GIFs and base data from GitHub project hasaneyldrm/exercises-dataset (1,324 exercises, 9 languages). Thanks to the original author.</string>
    <string name="about_developer_title">Developer</string>
    <string name="about_developer_text">Developer: Jack Li &amp; Claude\nClaude implements code, Jack Li drives requirements, testing, and quality.</string>
    <string name="about_version_title">Version</string>
    <string name="about_version">v2.0.0 (with multi-language)</string>
    <string name="about_repo_title">GitHub Repository</string>
    <string name="about_repo_url">https://github.com/63894696</string>
    <string name="about_repo_action">Open in browser</string>
    <string name="about_license_title">Open Source License</string>
    <string name="about_license_text">Released under MIT License. Free to use, modify, redistribute, with copyright preserved.</string>
    <string name="about_license_url">https://opensource.org/licenses/MIT</string>
    <string name="about_disclaimer_title">Disclaimer</string>
    <string name="about_disclaimer_text">This app is for reference only and does not replace professional medical or fitness advice.\n\nEveryone\'s body is different. Please consult a doctor or certified trainer before starting any program.\n\nPerform all exercises under professional guidance and progress gradually to avoid injury.\n\nYou assume all responsibility for using this app.</string>
