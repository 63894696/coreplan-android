    <!-- About screen -->
    <string name="about_app_name">健身指南</string>
    <string name="about_intro_title">简介</string>
    <string name="about_intro_text">本应用收录了 1,324 个健身动作，涵盖力量训练、有氧、拉伸等。所有 GIF 演示图都来自公开数据集。我们希望本应用能帮助大家方便地查阅动作要点、建立自己的训练计划。</string>
    <string name="about_open_source_title">开源免费</string>
    <string name="about_open_source_text">本应用是完全开源、免费的健身参考工具。不接入广告、不收集用户数据、不要求登录。代码在 GitHub 公开，欢迎审查、复用与二次开发。</string>
    <string name="about_dataset_title">数据集来源</string>
    <string name="about_dataset_text">动作 GIF 和基础数据来自 GitHub 开源项目 hasaneyldrm/exercises-dataset（共 1,324 个动作，9 种语言支持）。感谢原作者的无私分享。</string>
    <string name="about_developer_title">开发者</string>
    <string name="about_developer_text">开发者：Jack Li &amp; Claude\nClaude 负责代码实现，Jack Li 负责需求、测试与质量把控。</string>
    <string name="about_version_title">版本</string>
    <string name="about_version">v2.0.0（加入多语言切换）</string>
    <string name="about_repo_title">GitHub 仓库</string>
